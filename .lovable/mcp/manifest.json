{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vajphiawnngpfarjiokb.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "tonight-mcp",
      "version": "0.1.0",
      "title": "Tonight"
    },
    "tools": [
      {
        "name": "recommend",
        "title": "Recommend a movie or show",
        "description": "Generate ONE personalized movie or TV recommendation for the signed-in Tonight user based on a mood prompt (e.g. 'a smart comedy', 'something like Harry Potter'). Also saves it to the user's history.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 2,
              "maxLength": 500,
              "description": "The user's mood or request, e.g. 'a movie to watch with my parents'."
            }
          },
          "required": [
            "prompt"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_favorites",
        "title": "List favorites",
        "description": "List the signed-in user's saved favorite movies and TV shows in Tonight.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max rows to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "save_favorite",
        "title": "Save favorite",
        "description": "Save a movie or TV show to the signed-in user's Tonight favorites.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Title of the movie or show."
            },
            "genre": {
              "type": "string",
              "description": "Genre string, e.g. 'Sci-fi thriller'."
            },
            "platform": {
              "type": "string",
              "description": "Streaming platform, e.g. 'Netflix'."
            },
            "rating": {
              "type": "string",
              "description": "Rating string, e.g. '8.1/10'."
            },
            "description": {
              "type": "string",
              "description": "Short plot description."
            },
            "reason": {
              "type": "string",
              "description": "Why it matches the user."
            },
            "poster_url": {
              "type": "string",
              "description": "Poster image URL."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "remove_favorite",
        "title": "Remove favorite",
        "description": "Remove a saved favorite from the signed-in user's Tonight favorites by its id.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "The favorite row id (uuid) returned by list_favorites."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_history",
        "title": "List recommendation history",
        "description": "List previous recommendations Tonight generated for the signed-in user, most recent first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max rows to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_taste_profile",
        "title": "Get taste profile",
        "description": "Return the signed-in user's Tonight taste profile: top genres, moods, directors, and cast, aggregated from favorites and feedback.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
